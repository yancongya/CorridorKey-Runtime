#pragma once

#include <cstdint>

namespace corridorkey::adobe {

inline constexpr char kEffectDisplayName[] = "@CORRIDORKEY_ADOBE_EFFECT_NAME@";
inline constexpr char kEffectCategory[] = "@CORRIDORKEY_ADOBE_EFFECT_CATEGORY@";
inline constexpr char kEffectMatchName[] = "@CORRIDORKEY_ADOBE_EFFECT_MATCH_NAME@";
inline constexpr char kEffectNodeFamily[] = "@CORRIDORKEY_ADOBE_EFFECT_NODE_FAMILY@";
inline constexpr bool kEffectNodeIsBlue = @CORRIDORKEY_ADOBE_EFFECT_NODE_IS_BLUE@;
inline constexpr char kEffectSupportUrl[] = "@CORRIDORKEY_ADOBE_EFFECT_SUPPORT_URL@";
inline constexpr std::int32_t kEffectVersionMajor = @CORRIDORKEY_ADOBE_EFFECT_VERSION_MAJOR@;
inline constexpr std::int32_t kEffectVersionMinor = @CORRIDORKEY_ADOBE_EFFECT_VERSION_MINOR@;
inline constexpr std::int32_t kEffectVersionBug = @CORRIDORKEY_ADOBE_EFFECT_VERSION_BUG@;
inline constexpr std::int32_t kEffectVersionStage = @CORRIDORKEY_ADOBE_EFFECT_VERSION_STAGE@;
inline constexpr std::int32_t kEffectVersionBuild = @CORRIDORKEY_ADOBE_EFFECT_VERSION_BUILD@;
// Packed with the same CMake bit layout that generates AE_Effect_Version in the PiPL
// resource. adobe_effect.cpp compares it against the AE SDK PF_VERSION macro at
// compile time so a layout drift fails the build instead of AE error 25::16 at load.
inline constexpr std::uint32_t kEffectVersionPacked = @CORRIDORKEY_ADOBE_EFFECT_VERSION@U;
inline constexpr std::int32_t kGlobalOutFlags = @CORRIDORKEY_ADOBE_GLOBAL_OUTFLAGS@;
inline constexpr std::int32_t kGlobalOutFlags2 = @CORRIDORKEY_ADOBE_GLOBAL_OUTFLAGS2@;

}  // namespace corridorkey::adobe
